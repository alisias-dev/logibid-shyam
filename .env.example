# ==========================================
# DATABASE CONFIGURATION (Neon Serverless Postgres)
# ==========================================
# DATABASE_URL: Neon pooled connection string with sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct non-pooled connection string (if using Prisma/Drizzle direct migrations)
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# JWT_SECRET: Secret key used to sign JWT tokens (REQUIRED, min 32 chars)
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"

# ALLOWED_ORIGINS: Comma-separated list of origins permitted to call the API with
# credentials. Same-origin requests are always allowed; unknown origins are blocked.
# Example: "https://fleexbid.vercel.app,https://admin.fleexbid.com"
ALLOWED_ORIGINS="https://www.fleexbid.live"

# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD: Used ONCE when the users table is empty
# to create the master admin. If unset, a random password is generated and printed
# to the server logs at first boot. Passwords are never reset on restart.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Master Administrator"

# ==========================================
# AI MODEL KEYS
# ==========================================
# GEMINI_API_KEY: Required for FleexBid AI Copilot & Rate Predictor (Google Gemini AI)
GEMINI_API_KEY="your-gemini-api-key"

# OPENAI_API_KEY: Optional. Placeholder for custom OpenAI integration
OPENAI_API_KEY="your-openai-api-key"

# ANTHROPIC_API_KEY: Optional. Placeholder for Claude integration
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ==========================================
# API & APPLICATION URLS
# ==========================================
# VITE_API_URL: Base URL for frontend API calls (leave as /api for relative relative routing on Vercel)
VITE_API_URL="/api"

# APP_URL: The public URL where this applet is hosted on Vercel
APP_URL="https://www.fleexbid.live"

# ==========================================
# NOTIFICATION SERVICES (OPTIONAL)
# ==========================================
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=
SMTP_PASS=
