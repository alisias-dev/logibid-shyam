# ==========================================
# DATABASE CONFIGURATION (Neon Serverless Postgres)
# ==========================================
# DATABASE_URL: Neon pooled connection string with sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct non-pooled connection string (if using Prisma/Drizzle direct migrations)
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# JWT_SECRET: Secret key used to sign JWT tokens
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"

# ==========================================
# AI MODEL KEYS
# ==========================================
# GEMINI_API_KEY: Required for LogiBid AI Copilot & Rate Predictor (Google Gemini AI)
GEMINI_API_KEY="your-gemini-api-key"

# OPENAI_API_KEY: Optional. Placeholder for custom OpenAI integration
OPENAI_API_KEY="your-openai-api-key"

# ANTHROPIC_API_KEY: Optional. Placeholder for Claude integration
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ==========================================
# API & APPLICATION URLS
# ==========================================
# VITE_API_URL: Base URL for frontend API calls (leave as /api for relative relative routing on Vercel)
VITE_API_URL="/api"

# APP_URL: The public URL where this applet is hosted on Vercel
APP_URL="https://logibid-g75t.vercel.app"

# ==========================================
# NOTIFICATION SERVICES (OPTIONAL)
# ==========================================
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=
SMTP_PASS=
